    "axios": "^1.12.2",
    "dotenv": "^17.2.3",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.1",
    "pocketbase": "^0.26.2",
    "quasar": "^2.16.0",
    "vue": "^3.5.22",
    "vue-router": "^4.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@quasar/app-vite": "^2.1.0",
    "@types/node": "^20.5.9",
    "@vue/eslint-config-typescript": "^14.4.0",
